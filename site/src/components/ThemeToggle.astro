---
// One button that switches between light and dark, instead of Starlight's
// three-way select. Uses Starlight's storage key, so the choice survives reloads.
---

<button type="button" class="td-theme-toggle" aria-label="Switch theme">
  <svg class="td-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
  <svg class="td-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"></path></svg>
</button>

<script>
  const theme = () => (document.documentElement.dataset.theme === 'light' ? 'light' : 'dark');
  const label = (btn: HTMLElement) =>
    btn.setAttribute('aria-label', theme() === 'dark' ? 'Switch to light theme' : 'Switch to dark theme');

  for (const btn of document.querySelectorAll<HTMLButtonElement>('.td-theme-toggle')) {
    label(btn);
    btn.addEventListener('click', () => {
      const next = theme() === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = next;
      try {
        localStorage.setItem('starlight-theme', next);
      } catch {}
      label(btn);
    });
  }
</script>
