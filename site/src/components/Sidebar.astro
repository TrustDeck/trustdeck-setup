---
// Starlight's sidebar plus a bar at the bottom: switch between the two docs
// sets, and links that leave the site.
import Default from '@astrojs/starlight/components/Sidebar.astro';
import { isUserDocs } from '../routeData';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const user = isUserDocs(Astro.url.pathname);
const sets = [
  { label: 'Developer Docs', href: `${base}/start/`, icon: 'code', current: !user },
  { label: 'User Docs', href: `${base}/user/`, icon: 'users', current: user },
];
const links = [
  { label: 'Source on GitHub', href: 'https://github.com/TrustDeck', icon: 'git' },
  { label: 'Report a problem', href: 'https://github.com/TrustDeck/trustdeck-backend/issues', icon: 'flag' },
];
---

<Default />

<div class="td-sidebar-bar">
  <ul aria-label="Documentation sets">
    {sets.map((s) => (
      <li><a class={`td-icon td-icon-${s.icon}`} href={s.href} aria-current={s.current ? 'true' : undefined}>{s.label}</a></li>
    ))}
  </ul>
  <ul aria-label="More">
    {links.map((l) => (
      <li><a class={`td-icon td-icon-${l.icon} td-external`} href={l.href} target="_blank" rel="noopener">{l.label}</a></li>
    ))}
  </ul>
</div>

<script>
  // In a long sidebar (deep in the API reference), bring the current page into view on load.
  const pane = document.querySelector<HTMLElement>('.sidebar-pane');
  const current = pane?.querySelector<HTMLElement>('a[aria-current="page"]');
  if (pane && current) {
    const p = pane.getBoundingClientRect();
    const c = current.getBoundingClientRect();
    const bar = pane.querySelector<HTMLElement>('.td-sidebar-bar')?.offsetHeight ?? 0;
    if (c.top < p.top || c.bottom > p.bottom - bar) pane.scrollTop += c.top - p.top - (p.height - bar) / 2;
  }
</script>
